# Copy to .env and adjust. .env is ignored by Git.

# PostgreSQL (used by docker compose and by the API)
POSTGRES_USER=cashscout
POSTGRES_PASSWORD=change-me
POSTGRES_DB=cashscout
POSTGRES_PORT=5432

# API
DATABASE_URL=postgres://cashscout:change-me@localhost:5432/cashscout
API_PORT=3000

# Port of the local stack (docker compose up)
APP_PORT=8080

# Authentication
# Secret for sessions: at least 32 random characters, e.g.
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
BETTER_AUTH_SECRET=change-me-to-a-long-random-secret
# Public URL of the app: the Vite dev server in dev
BETTER_AUTH_URL=http://localhost:5173

# Super user, created at first start if none exists. Signs in to create users;
# sees no book unless a member.
SUPERUSER_EMAIL=admin@example.com
SUPERUSER_PASSWORD=change-me-too
SUPERUSER_NAME=Administrator

# Production only (docs/deployment.md)
# Docker network of the reverse proxy; BETTER_AUTH_URL must then be the public https address
# PROXY_NETWORK=caddy
