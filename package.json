{
  "name": "cash-scout",
  "private": true,
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@12.21.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @cash-scout/api --filter @cash-scout/web dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "vitest run",
    "lint": "eslint .",
    "format": "prettier --write .",
    "db:up": "docker compose up -d db",
    "stack:up": "docker compose --profile stack up -d --build",
    "stack:down": "docker compose --profile stack down",
    "db:generate": "pnpm --filter @cash-scout/api db:generate",
    "db:migrate": "pnpm --filter @cash-scout/api db:migrate",
    "import:reference": "pnpm --filter @cash-scout/api import:reference",
    "import:journal": "pnpm --filter @cash-scout/api import:journal",
    "migrate:adjustments": "pnpm --filter @cash-scout/api migrate:adjustments"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.6",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "prettier": "^3.10.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.73.0",
    "vitest": "^5.1.1"
  }
}
